---
import Arrow from '../components/Arrow.astro';
import ProductPreview from '../components/ProductPreview.astro';
import { products } from '../data/products';
import { productsPath, site } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';

const principles = [
  { title: 'Start with the problem', description: 'We look at where things get in the way before deciding what to build.' },
  { title: 'Keep it simple', description: 'Everyday tasks should feel easy, not like a puzzle to solve.' },
  { title: 'Keep improving', description: 'Shipping is a beginning. We listen, fix what needs fixing, and keep refining.' },
  { title: 'Make room for ideas', description: 'Good ideas can come from anyone. Feedback and contributions help shape what comes next.' },
];
---
<SiteLayout title={`${site.name} — ${site.tagline}`}>
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title" data-parallax-region>
      <div class="container hero-inner">
        <div class="hero-copy">
          <h1 id="hero-title" lang="en" data-intro>Building <span>software</span> <em>for real needs.</em></h1>
          <p class="hero-mission" data-intro>{site.mission}</p>
          <div class="hero-actions" data-intro>
            <a class="action action-primary" href={productsPath} lang="en">Explore Products <Arrow /></a>
            <a class="action action-secondary" href={site.github} lang="en">GitHub <Arrow direction="diagonal" /></a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true" data-intro>
          <picture data-parallax-artwork>
            <source media="(max-width: 720px)" srcset="/images/openurain-fold-small.webp" />
            <img
              src="/images/openurain-fold.webp"
              width="1080"
              height="995"
              alt=""
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </section>

    <section class="container products-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <p class="section-label" lang="en" data-reveal>Featured Product</p>
        <h2 id="featured-title" data-reveal>Meet Zibblu</h2>
      </div>
      <ProductPreview product={products[0]} headingLevel={3} />
    </section>

    <section id="about" class="about-section" aria-labelledby="about-title">
      <div class="container about-inner">
        <div class="about-intro">
          <p class="section-label" lang="en" data-reveal>About</p>
          <h2 id="about-title" data-reveal>What we<br />value</h2>
          <p data-reveal>Good software is more than a list of features. It should solve a real problem and feel right in everyday use.</p>
        </div>
        <dl class="principles">
          {principles.map((principle) => (
            <div data-reveal>
              <dt>{principle.title}</dt>
              <dd>{principle.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="container community-section" aria-labelledby="community-title">
      <div>
        <p class="section-label" lang="en" data-reveal>Community</p>
        <h2 id="community-title" data-reveal>Got an idea? Let's talk.</h2>
        <p data-reveal>Something not working the way you expected? Have an idea for making it better? Open an issue, join a discussion, or send a pull request on GitHub.</p>
      </div>
      <a class="action action-secondary community-link" href={site.github} data-reveal>Find us on GitHub <Arrow direction="diagonal" /></a>
    </section>
  </main>
</SiteLayout>
