---
import Arrow from '../components/Arrow.astro';
import ProductPreview from '../components/ProductPreview.astro';
import { products } from '../data/products';
import { productsPath, site } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';

const principles = [
  { title: 'Start with the problem', description: 'Pay attention to what gets in people’s way.' },
  { title: 'Keep it simple', description: 'Make common tasks easy to find and easy to do.' },
  { title: 'Keep improving', description: 'Keep listening and fixing what slows people down after release.' },
  { title: 'Make room for ideas', description: 'Let feedback and contributions shape what comes next.' },
];
---
<SiteLayout title={`${site.name} — ${site.tagline}`}>
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container editorial-grid hero-inner">
        <div class="hero-copy">
          <h1 id="hero-title"><span data-intro>Building software</span> <span data-intro>for real needs.</span></h1>
          <p class="hero-mission" data-intro>{site.mission}</p>
          <div class="hero-actions" data-intro>
            <a class="action action-primary" href={productsPath}>Explore products <Arrow /></a>
            <a class="action action-quiet" href={site.github}>GitHub <Arrow direction="diagonal" /></a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <picture>
            <source media="(max-width: 47.99rem)" srcset="/images/openurain-fold-small.webp" width="580" height="534" />
            <img
              src="/images/openurain-fold.webp"
              width="1080"
              height="995"
              alt=""
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
      </div>
    </section>

    <section class="container products-section" aria-label="Featured product">
      <ProductPreview product={products[0]} />
    </section>

    <section id="about" class="about-section" aria-labelledby="about-title">
      <div class="container editorial-grid about-inner">
        <div class="about-intro">
          <h2 id="about-title" class="section-title">What matters</h2>
          <p>The real test of our work is how it feels to use every day.</p>
        </div>
        <dl class="principles">
          {principles.map((principle) => (
            <div data-reveal="principle">
              <dt>{principle.title}</dt>
              <dd>{principle.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="container editorial-grid community-section" aria-labelledby="community-title">
      <div class="community-copy" data-reveal>
        <h2 id="community-title" class="section-title">Got an idea?</h2>
        <p>Share feedback, open an issue, or contribute on GitHub.</p>
      </div>
      <a class="action action-secondary community-link" href={site.github} data-reveal="community-link">Find us on GitHub <Arrow direction="diagonal" /></a>
    </section>
  </main>
</SiteLayout>
