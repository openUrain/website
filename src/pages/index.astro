---
import Arrow from '../components/Arrow.astro';
import BrandIcon from '../components/BrandIcon.astro';
import ProductPreview from '../components/ProductPreview.astro';
import { products } from '../data/products';
import { productsPath, site } from '../data/site';
import SiteLayout from '../layouts/SiteLayout.astro';

const principles = [
  {
    index: '01',
    icon: 'problem' as const,
    title: 'Start with the problem',
    description: 'Pay attention to what gets in people’s way before writing a single line of interface.',
  },
  {
    index: '02',
    icon: 'clarity' as const,
    title: 'Keep it simple',
    description: 'Make common tasks easy to find, calm to read, and dependable to complete.',
  },
  {
    index: '03',
    icon: 'craft' as const,
    title: 'Keep improving',
    description: 'Listen closely after release and steadily remove friction that slows daily work.',
  },
  {
    index: '04',
    icon: 'ideas' as const,
    title: 'Make room for ideas',
    description: 'Build in the open so feedback and contributions shape what comes next.',
  },
];
---
<SiteLayout title={`${site.name} — ${site.tagline}`}>
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title" data-parallax-stage>
      <div class="hero-backdrop" aria-hidden="true">
        <div class="hero-aura hero-aura--primary"></div>
        <div class="hero-aura hero-aura--secondary"></div>
        <svg class="hero-grid-svg" viewBox="0 0 1200 720" fill="none" preserveAspectRatio="xMidYMid slice">
          <defs>
            <linearGradient id="hexLine" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#1546c8" stop-opacity="0.16" />
              <stop offset="50%" stop-color="#2d9cff" stop-opacity="0.08" />
              <stop offset="100%" stop-color="#1546c8" stop-opacity="0" />
            </linearGradient>
          </defs>
          <polygon points="880,72 1104,202 1104,462 880,592 656,462 656,202" stroke="url(#hexLine)" stroke-width="1" />
          <polygon points="880,128 1056,230 1056,434 880,536 704,434 704,230" stroke="url(#hexLine)" stroke-width="1" />
          <line x1="656" y1="202" x2="1104" y2="462" stroke="url(#hexLine)" stroke-width="1" />
          <line x1="880" y1="32" x2="880" y2="640" stroke="url(#hexLine)" stroke-width="1" />
        </svg>
      </div>

      <div class="container editorial-grid hero-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow" data-intro>
            <span class="eyebrow-prism" aria-hidden="true"></span>
            <span>Open-source software studio</span>
          </div>
          <h1 id="hero-title">
            <span class="headline-line"><span data-intro>Building software</span></span>
            <span class="headline-line"><span class="headline-accent" data-intro>for real needs.</span></span>
          </h1>
          <p class="hero-mission" data-intro>{site.mission}</p>
          <div class="hero-actions" data-intro>
            <a class="action action-primary" href={productsPath}>Explore products <Arrow /></a>
            <a class="action action-glass" href={site.github}>GitHub <Arrow direction="diagonal" /></a>
          </div>
        </div>

        <div class="hero-sculpture" aria-hidden="true">
          <div class="prism-plane prism-plane--back" data-parallax-depth="-0.8"></div>
          <div class="prism-ring" data-parallax-depth="-0.4"></div>
          <picture class="prism-mark" data-parallax-depth="0.5">
            <source media="(max-width: 47.99rem)" srcset="/images/openurain-fold-small.webp" width="580" height="534" />
            <img
              src="/images/openurain-fold.webp"
              width="1080"
              height="995"
              alt=""
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          <div class="prism-plane prism-plane--front" data-parallax-depth="1.05">
            <span class="prism-facet-line"></span>
          </div>
        </div>
      </div>
    </section>

    <section class="container products-section" aria-labelledby="featured-kicker">
      <div class="section-header" data-reveal>
        <p id="featured-kicker" class="section-kicker">Featured Software</p>
        <a class="section-more" href={productsPath}>All products <Arrow /></a>
      </div>
      <ProductPreview product={products[0]} />
    </section>

    <section id="about" class="about-section" aria-labelledby="about-title">
      <div class="about-aura" aria-hidden="true"></div>
      <div class="container editorial-grid about-inner">
        <div class="about-intro" data-reveal>
          <p class="section-kicker">Philosophy</p>
          <h2 id="about-title" class="section-title">What matters</h2>
          <p>The real test of our work is how it feels to use every day — clear boundaries, honest capabilities, and calm craft.</p>
        </div>
        <dl class="principles">
          {principles.map((principle) => (
            <div class="principle-row" data-reveal="principle">
              <span class="principle-index" aria-hidden="true">{principle.index}</span>
              <dt>
                <BrandIcon name={principle.icon} medallion />
                <span>{principle.title}</span>
              </dt>
              <dd>{principle.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="container community-wrap" aria-labelledby="community-title">
      <div class="community-glass" data-reveal>
        <div class="community-prism" aria-hidden="true">
          <svg viewBox="0 0 320 320" fill="none">
            <polygon points="160,16 286,88 286,232 160,304 34,232 34,88" stroke="currentColor" stroke-width="1.2" opacity="0.14" />
            <polygon points="160,56 250,108 250,212 160,264 70,212 70,108" stroke="currentColor" stroke-width="1.2" opacity="0.22" />
          </svg>
        </div>
        <div class="community-copy">
          <BrandIcon name="opensource" medallion />
          <div>
            <h2 id="community-title" class="section-title">Got an idea?</h2>
            <p>Share feedback, open an issue, or contribute on GitHub.</p>
          </div>
        </div>
        <a class="action action-primary community-link" href={site.github} data-reveal="community-link">
          Find us on GitHub <Arrow direction="diagonal" />
        </a>
      </div>
    </section>
  </main>
</SiteLayout>
