---
import type { GetStaticPaths } from 'astro';
import Arrow from '../../components/Arrow.astro';
import ProductArtwork from '../../components/ProductArtwork.astro';
import { productPath, products, type Product } from '../../data/products';
import { productsPath, site } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';

export const getStaticPaths = (() => products.map((product) => ({
  params: { id: product.id },
  props: { product },
}))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
---
<SiteLayout
  title={`${product.name} | ${site.name}`}
  description={product.summary}
  pathname={productPath(product.id)}
>
  <main id="main-content" class:list={['product', `product--${product.id}`]} tabindex="-1">
    <div class="product-detail-hero">
      <div class="container">
        <a class="product-back" href={productsPath}><Arrow direction="left" /> Back to products</a>

        <header class="editorial-grid product-stage product-detail-stage">
          <div class="product-copy">
            <div class="product-name" data-intro>
              <img src={product.icon} alt="" width="44" height="44" decoding="async" />
              <div>
                <h1>{product.name}</h1>
                <p class="product-platform">{product.platform}</p>
              </div>
            </div>
            <p class="product-tagline" data-intro>{product.tagline}</p>
            <p class="product-description" data-intro>{product.description}</p>
            <div class="product-actions" data-intro>
              {product.website && (
                <a class="action action-primary" href={product.website}>
                  Explore {product.name} <Arrow direction="diagonal" />
                </a>
              )}
              {product.downloadUrl && (
                <a class:list={['action', product.website ? 'action-secondary' : 'action-primary']} href={product.downloadUrl}>
                  Download for Windows <Arrow direction="diagonal" />
                </a>
              )}
              <a
                class:list={['action', product.downloadUrl ? 'action-secondary' : 'action-primary']}
                href={product.repository}
              >
                GitHub (access required) <Arrow direction="diagonal" />
              </a>
            </div>
          </div>
          <ProductArtwork artwork={product.artwork} priority />
        </header>
      </div>
    </div>

    {product.downloadUrl && product.iosBuildUrl && (
      <section class="container platform-section" id="platforms" aria-labelledby="platforms-title">
        <h2 class="section-title" id="platforms-title">Choose your platform.</h2>
        <div class="platform-grid">
          <article class="platform-card">
            <span class="platform-state">Windows · v0.1.5</span>
            <h3>Windows</h3>
            <p>Windows 10 / 11 · x64 · v0.1.5 installer hosted on openUrain R2.</p>
            <a class="action action-primary" href={product.downloadUrl}>Download Windows installer <Arrow direction="diagonal" /></a>
            {product.windowsLatestUrl && <a class="platform-link" href={product.windowsLatestUrl}>GitHub Release mirror · repository access required <Arrow direction="diagonal" /></a>}
          </article>
          <article class="platform-card">
            <span class="platform-state">Developer preview · unsigned</span>
            <h3>iPhone / iOS</h3>
            <p>iOS 16.4+ · v0.1.5 unsigned test IPA, hosted on openUrain R2. Sign it yourself with a free Apple Account and Sideloadly. This is not an App Store or TestFlight release and cannot be installed by simply tapping the IPA.</p>
            <a class="action action-secondary" href={product.iosBuildUrl}>Download unsigned iOS IPA <Arrow direction="diagonal" /></a>
            {product.iosInstallGuideUrl && <a class="platform-link" href={product.iosInstallGuideUrl}>Free installation guide <Arrow direction="diagonal" /></a>}
            {product.iosActionsUrl && <a class="platform-link" href={product.iosActionsUrl}>GitHub Actions build history · repository access required <Arrow direction="diagonal" /></a>}
          </article>
        </div>
      </section>
    )}

    <div class="container product-details">
      {product.featureGroups.map((group, index) => (
        <section class="editorial-grid feature-group" aria-labelledby={`feature-group-${index}`}>
          <h2 class="section-title" id={`feature-group-${index}`}>{group.title}</h2>
          <dl class="product-features">
            {group.features.map((feature) => (
              <div>
                <dt>{feature.title}</dt>
                <dd>{feature.description}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>
