---
import type { GetStaticPaths } from 'astro';
import Arrow from '../../components/Arrow.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import ProductArtwork from '../../components/ProductArtwork.astro';
import { productPath, products, type Product } from '../../data/products';
import { productsPath, site } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';

export const getStaticPaths = (() => products.map((product) => ({
  params: { id: product.id },
  props: { product },
}))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
---
<SiteLayout
  title={`${product.name} | ${site.name}`}
  description={product.summary}
  pathname={productPath(product.id)}
>
  <main id="main-content" class:list={['product', 'product-detail', `product--${product.id}`]} tabindex="-1">
    <div class="product-detail-hero">
      <div class="product-detail-aura" aria-hidden="true"></div>
      <div class="container">
        <a class="product-back" href={productsPath}><Arrow direction="left" /> Back to products</a>

        <header class="editorial-grid product-stage product-detail-stage">
          <div class="product-copy">
            <div class="product-header-row" data-intro>
              <div class="product-icon-shell">
                <img src={product.icon} alt="" width="44" height="44" decoding="async" />
              </div>
              <div>
                <h1>{product.name}</h1>
                <p class="product-platform">{product.platform} · {product.version}</p>
              </div>
            </div>
            <p class="product-tagline" data-intro>{product.tagline}</p>
            <p class="product-description" data-intro>{product.description}</p>
            <div class="product-actions" data-intro>
              {product.website && (
                <a class="action action-primary" href={product.website}>
                  Explore {product.name} <Arrow direction="diagonal" />
                </a>
              )}
              {product.downloadUrl && (
                <a class="action action-glass" href={product.downloadUrl}>
                  <BrandIcon name="download" size={20} />
                  Download for Windows
                </a>
              )}
              <a class="action action-quiet" href={product.repository}>
                GitHub <Arrow direction="diagonal" />
              </a>
            </div>
            {product.checksumUrl && product.releaseUrl && (
              <p class="product-verify-links" data-intro>
                <a href={product.checksumUrl}>SHA-256 checksum</a>
                <span aria-hidden="true">·</span>
                <a href={product.releaseUrl}>Release notes ({product.version})</a>
              </p>
            )}
          </div>
          <ProductArtwork
            artwork={product.artwork}
            secondary={product.secondaryArtwork}
            priority
            variant="detail"
          />
        </header>
      </div>
    </div>

    <div class="container product-details">
      {product.featureGroups.map((group, index) => (
        <section class="editorial-grid feature-group" aria-labelledby={`feature-group-${index}`}>
          <div class="feature-group-head" data-reveal>
            <p class="section-kicker">0{index + 1}</p>
            <h2 class="section-title" id={`feature-group-${index}`}>{group.title}</h2>
            <p class="feature-group-subtitle">{group.subtitle}</p>
          </div>
          <dl class="product-features">
            {group.features.map((feature) => (
              <div class="feature-item" data-reveal="principle">
                <dt>
                  <BrandIcon name={feature.icon} tone="zibblu" medallion />
                  <span>{feature.title}</span>
                </dt>
                <dd>{feature.description}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>
