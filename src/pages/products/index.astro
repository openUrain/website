---
import ProductPreview from '../../components/ProductPreview.astro';
import { products } from '../../data/products';
import { productsPath, site } from '../../data/site';
import SiteLayout from '../../layouts/SiteLayout.astro';

const description = 'Explore software from openUrain, starting with Zibblu for Windows.';
---
<SiteLayout title={`Products | ${site.name}`} description={description} pathname={productsPath}>
  <main id="main-content" tabindex="-1">
    <header class="container editorial-grid catalog-intro">
      <h1 class="page-title" data-intro>Products</h1>
      <p class="catalog-description" data-intro>Meet the software we make, starting with Zibblu.</p>
    </header>

    <div class="container catalog-products">
      {products.map((product, index) => <ProductPreview product={product} priority={index === 0} />)}
    </div>
  </main>
</SiteLayout>
