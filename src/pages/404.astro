---
import Arrow from '../components/Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="页面未找到 | openUrain" description="你访问的页面未找到。可以返回 openUrain 首页继续浏览。" noindex>
  <main id="main-content" class="container not-found" tabindex="-1">
    <p class="section-label">404</p>
    <h1>这个页面找不到了。</h1>
    <p>可以返回首页，继续浏览 openUrain 的项目。</p>
    <a class="action action-primary" href="/">返回首页 <Arrow /></a>
  </main>
</SiteLayout>
