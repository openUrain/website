---
import Arrow from '../components/Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found | openUrain" description="This page could not be found. Return to the openUrain homepage." noindex>
  <main id="main-content" class="container not-found" tabindex="-1">
    <h1 class="page-title">Page not found.</h1>
    <p>Check the address or head back to the homepage.</p>
    <a class="action action-primary" href="/">Back to home <Arrow /></a>
  </main>
</SiteLayout>
