---
import Arrow from '../components/Arrow.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found | openUrain" description="This page could not be found. Head back to openUrain to explore our projects." noindex>
  <main id="main-content" class="container not-found" tabindex="-1">
    <p class="section-label">404</p>
    <h1>Looks like a wrong turn.</h1>
    <p>The link might be off, or the page may have moved. Let's get you back on track.</p>
    <a class="action action-primary" href="/">Back to home <Arrow /></a>
  </main>
</SiteLayout>
