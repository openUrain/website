---
import Arrow from './Arrow.astro';
import { productsPath, site } from '../data/site';

interface Props {
  currentPath?: string;
  footer?: boolean;
}

const { currentPath, footer = false } = Astro.props;
const productsIsCurrent = currentPath === productsPath;
const inProducts = productsIsCurrent || currentPath?.startsWith(`${productsPath}/`);
---
<nav aria-label={footer ? 'Footer navigation' : 'Main navigation'} class:list={['site-nav', { 'footer-nav': footer }]}>
  <a
    href={productsPath}
    class:list={{ 'nav-active': inProducts }}
    aria-current={productsIsCurrent ? 'page' : undefined}
  >Products</a>
  <a href="/#about">About</a>
  <a href={site.github}>GitHub <Arrow direction="diagonal" /></a>
</nav>
