---
import Arrow from './Arrow.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---
<article class:list={['product', `product--${product.id}`]} aria-labelledby={`${product.id}-title`}>
  <div class="product-stage">
    <div class="product-copy">
      <div class="product-name">
        <img src={product.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />
        <h3 id={`${product.id}-title`} lang="en">{product.name}</h3>
      </div>
      <p class="product-tagline" lang="en">
        {product.tagline.map((line) => <span>{line}{' '}</span>)}
      </p>
      <p class="product-description">{product.description}</p>
      <div class="product-actions">
        <a
          class="action action-primary"
          href={product.repository}
          aria-describedby={product.repositoryAccess ? `${product.id}-access` : undefined}
        >
          GitHub 项目 <Arrow direction="diagonal" />
        </a>
        <div class="product-platform">
          <span>{product.platform}</span>
          {product.repositoryAccess && <span id={`${product.id}-access`}>{product.repositoryAccess}</span>}
        </div>
      </div>
    </div>
    <div class="product-visual" aria-hidden="true">
      <img
        src={product.artwork.src}
        width={product.artwork.width}
        height={product.artwork.height}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
  <dl class="product-features">
    {product.features.map((feature) => (
      <div>
        <dt>{feature.title}</dt>
        <dd>{feature.description}</dd>
      </div>
    ))}
  </dl>
</article>
