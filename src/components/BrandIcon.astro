        <circle cx="12" cy="12" r="1.25" fill="currentColor" stroke="none" />
      </>
    )}
    {name === 'clarity' && (
      <>
        <rect x="4" y="4.5" width="16" height="15" rx="3" />
        <path d="M8 9.5h8M8 13h5.5M8 16.5h3.5" />
      </>
    )}
    {name === 'craft' && (
      <>
        <path d="M4 16.5 9.5 11l3.5 3.5L20 7.5" />
        <path d="M15.5 7.5H20V12" />
      </>
    )}
    {name === 'ideas' && (
      <>
        <polygon points="12 3.5 19.5 7.75 19.5 16.25 12 20.5 4.5 16.25 4.5 7.75" />
        <path d="M12 8.5v7M8.5 12h7" />
      </>
    )}
  </svg>
)}
