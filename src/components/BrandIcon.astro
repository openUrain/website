        <path d="M8.5 11.5h7M8.5 14.5h4.2" />
      </>
    )}
    {name === 'files' && (
      <>
        <path d="M3.5 7.5a2 2 0 0 1 2-2h4.2l1.8 2.2h7a2 2 0 0 1 2 2v7.8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-10Z" />
        <path d="M12 11.5v5m-2.5-2.5L12 16.5l2.5-2.5" />
      </>
    )}
    {name === 'lan' && (
      <>
        <rect x="3.5" y="4.5" width="7" height="6" rx="1.5" />
        <rect x="13.5" y="13.5" width="7" height="6" rx="1.5" />
        <path d="M10.5 7.5h3.5a2 2 0 0 1 2 2v4M13.5 16.5H10a2 2 0 0 1-2-2v-4" />
      </>
    )}
    {name === 'privacy' && (
      <>
        <rect x="5" y="10.5" width="14" height="9.5" rx="2.5" />
        <path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3M12 14.2v2.4" />
      </>
    )}
    {name === 'ai' && (
      <>
        <path d="M12 3.5 14.4 9.6 20.5 12l-6.1 2.4L12 20.5l-2.4-6.1L3.5 12l6.1-2.4L12 3.5Z" />
        <circle cx="18.5" cy="5.5" r="1.25" />
      </>
    )}
    {name === 'server' && (
      <>
        <rect x="3.5" y="4" width="17" height="6.5" rx="2" />
        <rect x="3.5" y="13.5" width="17" height="6.5" rx="2" />
        <path d="M7 7.25h.01M7 16.75h.01M10.5 7.25h6.5M10.5 16.75h6.5" />
