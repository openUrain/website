---
import Arrow from './Arrow.astro';
import ProductArtwork from './ProductArtwork.astro';
import { productPath, type Product } from '../data/products';

interface Props {
  product: Product;
  priority?: boolean;
}
const { product, priority = false } = Astro.props;
const titleId = `${product.id}-title`;
const ctaId = `${product.id}-cta`;
---
<article
  class:list={['product', 'product-preview', `product--${product.id}`]}
  aria-labelledby={titleId}
>
  <a class="editorial-grid product-stage product-preview-link" href={productPath(product.id)} aria-labelledby={ctaId}>
    <div class="product-copy" data-intro={priority ? '' : undefined}>
      <div class="product-name">
        <img src={product.icon} alt="" width="44" height="44" loading="lazy" decoding="async" />
        <h2 id={titleId}>{product.name}</h2>
      </div>
      <p class="product-tagline">{product.tagline}</p>
      <p class="product-description">{product.summary}</p>
      <span class="product-preview-cta" id={ctaId}>Explore {product.name} <Arrow /></span>
    </div>
    <ProductArtwork artwork={product.artwork} priority={priority} />
  </a>
</article>
