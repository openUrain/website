---
import type { Product } from '../data/products';

interface Props {
  artwork: Product['artwork'];
  priority?: boolean;
}
const { artwork, priority = false } = Astro.props;
---
<div class="product-visual" aria-hidden="true" data-intro={priority ? '' : undefined}>
  <img
    src={artwork.src}
    width={artwork.width}
    height={artwork.height}
    alt=""
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
  />
</div>
