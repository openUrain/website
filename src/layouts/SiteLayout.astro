---
import '../styles/site.css';
import '../styles/motion.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  pathname?: string;
  noindex?: boolean;
}

const { title, description = site.description, pathname = '/', noindex = false } = Astro.props;
const canonical = new URL(pathname, Astro.site);
const socialImage = new URL('/images/openurain-social.png', Astro.site);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfdff" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:locale" content="zh_CN" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="openUrain 蓝白标志与 Building software for real needs. 品牌理念" />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header currentPath={pathname} />
    <slot />
    <Footer currentPath={pathname} />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
